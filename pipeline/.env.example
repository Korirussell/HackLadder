# Copy to pipeline/.env. Never commit real values (CLAUDE.md §2).

# Supabase project URL, e.g. https://<ref>.supabase.co
SUPABASE_URL=
# Service-role key: bypasses RLS. Server-side pipeline use only (§7.7).
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection for `hl` (Dashboard > Connect > Session pooler). Includes the DB password.
DATABASE_URL=
